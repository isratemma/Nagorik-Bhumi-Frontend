# App
NEXT_PUBLIC_APP_NAME=Nagorik Bhumi
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API
# Local dev:
# NEXT_PUBLIC_API_URL=http://localhost:5000/api
# NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Production:
NEXT_PUBLIC_API_URL=https://nagorik-bhumi-backend-wra2.vercel.app/api
NEXT_PUBLIC_BACKEND_URL=https://nagorik-bhumi-backend-wra2.vercel.app

# Support
